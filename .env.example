# Frontend environment variables for Bzy mobile app.
# Copy to .env and adjust as needed.

# Set to "false" to use the real backend API instead of mock data.
EXPO_PUBLIC_USE_MOCKS=false

# Base URL of the Bzy backend API.
EXPO_PUBLIC_API_BASE_URL=https://bzy.6845165.xyz

# Stripe publishable key (for in-app deposit payments).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Updated: 2026-07-23
