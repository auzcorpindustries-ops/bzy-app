# ─── Server ───
PORT=3001
NODE_ENV=development
CORS_ORIGIN=*

# ─── AWS ───
AWS_REGION=us-east-2
DYNAMODB_ENDPOINT=           # blank for production (uses real DynamoDB)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── JWT ───
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Stripe ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Square ───
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=

# ─── Twilio ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ─── OpenAI ───
OPENAI_API_KEY=

# ─── ElevenLabs ───
ELEVENLABS_API_KEY=

# ─── Expo Push ───
EXPO_ACCESS_TOKEN=

# ─── Resend ───
RESEND_API_KEY=
